# Local/Render environment example — NEVER commit real secrets.
DEBUG=False
SECRET_KEY=generate-a-long-random-secret
ALLOWED_HOSTS=passamoz.onrender.com
CSRF_TRUSTED_ORIGINS=https://passamoz.onrender.com

# Render PostgreSQL can be exposed through DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional
REDIS_URL=
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
DB_CONN_MAX_AGE=60
# Recuperação de conta / SMTP (Render)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PassaMoz <seu-email@gmail.com>
# E-mail que recebe pedidos de novas operadoras
PASSAMOZ_ADMIN_EMAIL=seu-email@gmail.com
PASSAMOZ_ACTIVATION_TIMEOUT_HOURS=24
EMAIL_TIMEOUT=20

# Gateway de pagamentos (produção)
NETSHOP_BASE_URL=https://www.netshop.co.mz/api
NETSHOP_API_KEY=
PAYMENT_GATEWAY_TIMEOUT=20
PAYMENT_WEBHOOK_TOKEN=
